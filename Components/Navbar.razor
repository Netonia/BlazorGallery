@code {
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<SortOrder> OnSortChanged { get; set; }
    [Parameter] public EventCallback<bool> OnThemeChanged { get; set; }

    private bool collapseNavMenu = true;
    private bool isDarkTheme = true;
    private string SearchTerm = string.Empty;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        await OnSearchChanged.InvokeAsync(SearchTerm);
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
        OnSearchChanged.InvokeAsync(SearchTerm);
    }

    private void SetSortOrder(SortOrder sortOrder)
    {
        OnSortChanged.InvokeAsync(sortOrder);
    }

    private void ToggleTheme()
    {
        isDarkTheme = !isDarkTheme;
        OnThemeChanged.InvokeAsync(isDarkTheme);
    }
}