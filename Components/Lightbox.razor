@using BlazorGallery.Services

<div class="lightbox-overlay" @onclick="CloseOnOverlayClick" @onkeydown="HandleKeyDown" tabindex="0">
    <div class="lightbox-content" @onclick:stopPropagation="true">
        <!-- Close button -->
        <button class="btn-close lightbox-close" @onclick="OnClose" aria-label="Close"></button>
        
        <!-- Navigation buttons -->
        @if (CanNavigatePrevious())
        {
            <button class="lightbox-nav lightbox-nav-prev" @onclick="NavigatePrevious" aria-label="Previous image">
                <i class="bi bi-chevron-left"></i>
            </button>
        }
        
        @if (CanNavigateNext())
        {
            <button class="lightbox-nav lightbox-nav-next" @onclick="NavigateNext" aria-label="Next image">
                <i class="bi bi-chevron-right"></i>
            </button>
        }
        
        <!-- Main image -->
        <div class="lightbox-image-container">
            <img src="@Image.Url" 
                 alt="@Image.Title" 
                 class="lightbox-image" />
        </div>
        
        <!-- Image info -->
        <div class="lightbox-info">
            <h5 class="lightbox-title">@Image.Title</h5>
            @if (!string.IsNullOrEmpty(Image.Description))
            {
                <p class="lightbox-description">@Image.Description</p>
            }
            @if (Image.Tags?.Any() == true)
            {
                <div class="lightbox-tags">
                    @foreach (var tag in Image.Tags)
                    {
                        <span class="badge bg-secondary me-1">@tag</span>
                    }
                </div>
            }
            <div class="lightbox-meta">
                <small class="text-muted">
                    @Image.DateCreated.ToString("MMMM d, yyyy")
                    • Image @(GetCurrentIndex() + 1) of @Images.Count
                </small>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public ImageInfo Image { get; set; } = default!;
    [Parameter] public List<ImageInfo> Images { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ImageInfo> OnNavigate { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Focus the lightbox for keyboard navigation
            await Task.Delay(100); // Small delay to ensure DOM is ready
            StateHasChanged();
        }
    }

    private void CloseOnOverlayClick()
    {
        OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key.ToLower())
        {
            case "escape":
                await OnClose.InvokeAsync();
                break;
            case "arrowleft":
                if (CanNavigatePrevious())
                    NavigatePrevious();
                break;
            case "arrowright":
                if (CanNavigateNext())
                    NavigateNext();
                break;
        }
    }

    private int GetCurrentIndex()
    {
        return Images.FindIndex(i => i.Filename == Image.Filename);
    }

    private bool CanNavigatePrevious()
    {
        return GetCurrentIndex() > 0;
    }

    private bool CanNavigateNext()
    {
        return GetCurrentIndex() < Images.Count - 1;
    }

    private void NavigatePrevious()
    {
        var currentIndex = GetCurrentIndex();
        if (currentIndex > 0)
        {
            var previousImage = Images[currentIndex - 1];
            OnNavigate.InvokeAsync(previousImage);
        }
    }

    private void NavigateNext()
    {
        var currentIndex = GetCurrentIndex();
        if (currentIndex < Images.Count - 1)
        {
            var nextImage = Images[currentIndex + 1];
            OnNavigate.InvokeAsync(nextImage);
        }
    }
}

